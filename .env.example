# ==============================================================================
# PROJETO NEXO — MODELO DE VARIÁVEIS DE AMBIENTE (TEMPLATE / .env.example)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# ==============================================================================

# 1. DJANGO CORE & SEGURANÇA
DJANGO_SECRET_KEY=change-this-in-production-to-a-very-strong-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,app,backend
DJANGO_PORT=8000

# 2. BANCO DE DADOS (POSTGRESQL)
POSTGRES_DB=contratacao_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# 3. MENSAGERIA & PROCESSAMENTO ASSÍNCRONO (RABBITMQ + CELERY)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

# 4. CORS (CROSS-ORIGIN RESOURCE SHARING)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 5. INTERNACIONALIZAÇÃO & FUSO HORÁRIO
TIME_ZONE=America/Recife
LANGUAGE_CODE=pt-br

# 6. FRONTEND (NEXT.JS)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
